INKGUARD_AI_MODE=rules
INKGUARD_SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
INKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional external AI mode. Keep the key on the backend only.
# Set INKGUARD_AI_MODE=openrouter to enable it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
